<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kisaan Voice Mesh (demo)" android:textSize="20sp"
            android:textStyle="bold" android:paddingBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Role"/>
        <Spinner android:id="@+id/spinnerRole"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <EditText android:id="@+id/editNodeId"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Node id (e.g. 1)" android:inputType="number" android:text="1"/>

        <EditText android:id="@+id/editEntryId"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Entry id to send (Origin)" android:inputType="number" android:text="1"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <Button android:id="@+id/btnStart" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Start"/>
            <Button android:id="@+id/btnStop" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop"/>
            <Button android:id="@+id/btnSend" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Send"/>
        </LinearLayout>

        <TextView android:id="@+id/txtMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="22sp" android:textDirection="rtl" android:gravity="end"
            android:paddingVertical="16dp" android:minHeight="80dp"
            android:text="(received advisory shows here)"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Log" android:textStyle="bold"/>
        <TextView android:id="@+id/txtLog"
            android:layout_width="match_parent" android:layout_height="260dp"
            android:fontFamily="monospace" android:textSize="11sp"
            android:background="#11000000" android:padding="8dp"/>

        <Button android:id="@+id/btnShare" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Share log (CSV)" android:paddingTop="8dp"/>
    </LinearLayout>
</ScrollView>
